# Required. Copy to .env.local and supply your own Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
# Bootstrap contact only. Never used to authorize access.
ADMIN_EMAIL=
# Required server-only credentials for trusted account activation.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_CONTEXT_SECRET=
# Required server-only invitation email configuration. Use a Google App Password, never the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
